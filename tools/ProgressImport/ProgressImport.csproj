<Project Sdk="Microsoft.NET.Sdk">
  <!-- daoc-progress: carries saved progress into a new world (macOS port of upstream Offline DAoC's
       OfflineDaoc.ProgressImport engine; see ImportEngine.cs). Published into the server's bin/ by
       tools/build-release.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DaocProgress</AssemblyName>
    <RootNamespace>DaocProgress</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The vendored System.Data.SQLite built with SQLITE_STANDARD (binds the macOS system
         libsqlite3), never the NuGet package: it has no osx-arm64 SQLite.Interop. -->
    <ProjectReference Include="../../vendor/System.Data.SQLite/System.Data.SQLite.NetStandard21.csproj"
                      AdditionalProperties="Configuration=Release;UseInteropDll=false;UseSqliteStandard=true;SignAssembly=false;PublicSign=false;DelaySign=false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="progress-policy.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
